<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.smalistean.propstrategy.xvf-funding-export</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/stas/workspace/other/prop-strategy/scripts/xvf-funding-export.sh</string>
    </array>

    <!-- Hourly at :55, after the recorder Lambda's :50 invocation. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>55</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/stas/workspace/other/prop-strategy</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/stas/workspace/other/prop-strategy/logs/xvf-funding-export-launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/stas/workspace/other/prop-strategy/logs/xvf-funding-export-launchd.err.log</string>
</dict>
</plist>
