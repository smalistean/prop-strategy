<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.smalistean.propstrategy.xvf-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/stas/workspace/other/prop-strategy/scripts/xvf-refresh.sh</string>
    </array>

    <!-- Daily at 06:45 local, before signal generation. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/stas/workspace/other/prop-strategy</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/stas/workspace/other/prop-strategy/logs/xvf-refresh-launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/stas/workspace/other/prop-strategy/logs/xvf-refresh-launchd.err.log</string>
</dict>
</plist>
